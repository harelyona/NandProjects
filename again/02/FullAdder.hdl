// File name: projects/02/FullAdder.hdl

/**
 * Computes the sum of three bits.
 */

CHIP FullAdder {
    IN a, b, c;  // 1-bit inputs
    OUT sum,     // Right bit of a + b + c
        carry;   // Left bit of a + b + c

    PARTS:
    Nand(a=a, b=b, out=k);
    Nand(a=a, b=k, out=aNandk);
    Nand(a=b, b=k, out=bNandk);
    Nand(a=aNandk, b=bNandk, out=x);
    Nand(a=x, b=c, out=t);
    Nand(a=x, b=t, out=xNandt);
    Nand(a=c, b=t, out=cNandt);
    Nand(a=xNandt, b=cNandt, out=sum);
    Nand(a=k, b=t, out=carry);
}